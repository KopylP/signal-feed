    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
    <PackageVersion Include="Telegram.Bot" Version="22.10.5" />
    <PackageVersion Include="WTelegramClient" Version="4.4.11" />
    <PackageVersion Include="xunit" Version="2.9.3" />
