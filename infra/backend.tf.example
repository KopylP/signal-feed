# State is local by default. To keep it in Azure:
#   1. copy this file to backend.tf
#   2. create a storage account and a container for the state
#   3. terraform init -migrate-state
terraform {
  backend "azurerm" {
    resource_group_name  = "rg-tfstate"
    storage_account_name = "sttfstate0000"
    container_name       = "tfstate"
    key                  = "signal-feed.tfstate"
  }
}
