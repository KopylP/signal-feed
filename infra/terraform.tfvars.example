# Copy to terraform.tfvars and fill in. Secrets (OpenAI, Telegram) do not go here:
# they are set with az keyvault secret set (see README).

location           = "westeurope"
name_prefix        = "signalfeed"
deployer_object_id = "00000000-0000-0000-0000-000000000000" # az ad signed-in-user show --query id -o tsv
budget_alert_email = "you@example.com"

# Sources: comma-separated usernames (defaults are already set in variables.tf; uncomment to change)
# sources = "badseo,needforseo,devakatalk,sneex_seo,SEOBAZA,seodre"

# Alerts only for these groups (channels never trigger alerts)
alert_sources = "some_group"

# Telegram (non-secret parts)
telegram_api_id = "1234567"
# The chat is bound by sending /start <TelegramPairingKey> to the bot. Set this only to override that with a fixed chat id.
# telegram_chat_id = ""

# Schedules (CRON in UTC, six fields: second minute hour day month weekday). These are the defaults.
# collector_schedule = "0 0 * * * *"
# digest_schedule    = "0 0 8 * * *"
# alert_schedule     = "0 30 * * * *"
# cleanup_schedule   = "0 0 3 * * *"

# Everything else: any parameter from src/PostAgent.Functions/Shared/Settings/AgentOptions.cs.
# Anything not set uses the default from code. Names must match exactly.
app_settings = {
  # DigestSize        = "5"
  # AlertThreshold    = "9"
  # AlertQuietHours   = "23:00-07:00"
  # AlertTimeZone     = "Europe/Kyiv"
  # RetentionDays     = "1"
  # OpenAIModel       = "gpt-5.4-nano"
}
