{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request;Exception"
      }
    },
    "logLevel": {
      "default": "Information",
      "Host.Results": "Error",
      "Function": "Information",
      "Azure.Core": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "extensions": {
    "queues": {
      "batchSize": 2,
      "newBatchThreshold": 0,
      "maxDequeueCount": 5
    }
  }
}
