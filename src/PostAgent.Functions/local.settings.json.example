{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",

    "Sources": "channel_one,channel_two,some_group",
    "CollectorSchedule": "0 0 * * * *",
    "DigestSchedule": "0 0 8 * * *",
    "DigestSize": "7",
    "InterestingThreshold": "7",
    "ScoringBatchSize": "10",
    "MaxPostChars": "1500",
    "MinPostChars": "80",

    "MaxItemsPerGroup": "5",
    "MaxBundleChars": "3000",
    "DailySummarySchedule": "0 0 3 * * *",
    "RetentionDays": "2",
    "AlertSources": "some_group",
    "AlertWindowHours": "3",
    "AlertCooldownHours": "3",
    "AlertThreshold": "9",
    "BurstMinPosts": "8",
    "AlertMaxPerRun": "3",
    "AlertQuietHours": "",
    "AlertTimeZone": "Europe/Kyiv",
    "Watches": "",
    "WatchSimilarityThreshold": "0.45",
    "DuplicateSimilarityThreshold": "0.9",
    "DuplicateWindowHours": "3",
    "TimeZone": "Europe/Kyiv",

    "ManualRunsEnabled": "true",

    "OpenAIModel": "gpt-5.4-nano",
    "OpenAIApiKey": "<openai-api-key>",
    "OpenAIChatModel": "gpt-6.1-terra",
    "ChatStreamEnabled": "true",
    "FeedbackEnabled": "true",
    "StatsRetentionDays": "90",

    "TelegramBotToken": "<bot-token>",
    "TelegramPairingKey": "<random-key-16-to-64-chars-A-Za-z0-9_->",
    "TelegramMaxChats": "5",
    "TelegramWebhookSecret": "<random-token-A-Za-z0-9_->",
    "TelegramApiId": "<api-id>",
    "TelegramApiHash": "<api-hash>",
    "SessionBlobContainer": "tg-session"
  }
}
